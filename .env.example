# MAS regulatory-updates pipeline (Vercel) — set these in Vercel Project Settings → Environment Variables.

# Firecrawl: scrapes the MAS website past its bot-detection. https://firecrawl.dev
FIRECRAWL_API_KEY=

# Vercel AI Gateway: summarises each MAS publication. https://vercel.com/docs/ai-gateway
AI_GATEWAY_API_KEY=

# Optional: model used for summarisation (defaults to openai/gpt-4o-mini).
MAS_SUMMARY_MODEL=openai/gpt-4o-mini

# Optional: shared secret to protect the daily cron endpoint (/api/mas-refresh).
# If set, the cron must send "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# Vercel Blob storage token is injected automatically when you connect a Blob
# store to the project (BLOB_READ_WRITE_TOKEN) — no manual value needed.
